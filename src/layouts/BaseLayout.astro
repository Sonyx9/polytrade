---
import '../styles/global.css';
import type { Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const {
  title = 'PL PolyTrade s.r.o. — Quality Across Trades',
  description = 'PL PolyTrade s.r.o. is a Czech company operating three specialist e-commerce brands: ProfiNůžky, Garden & Hobby, and Grill & Hobby.',
  lang = 'en',
} = Astro.props;
const assetBase = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${assetBase}images/og-cover.jpg`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-gray-900 font-['Inter',system-ui,sans-serif] antialiased">
    <slot />
  </body>
</html>
