---
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

---

<section id="about" class="py-14 bg-white border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mb-8">
      <p class="text-gray-600 leading-relaxed mb-4 text-[15px]">
        {t(lang, 'about_p1')}
      </p>
      <p class="text-gray-600 leading-relaxed text-[15px]">
        {t(lang, 'about_p2')}
      </p>
    </div>

    <div class="grid lg:grid-cols-[1fr_320px] gap-10 items-stretch">

      <!-- Left: featured article card style -->
      <div>
        <div class="relative rounded-2xl overflow-hidden aspect-[16/7] bg-gray-100">
          <img
            src="/images/Scissors_near_grill_202603311633.jpeg"
            alt="PL PolyTrade s.r.o."
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

      </div>

      <!-- Right sidebar: company card + popular articles -->
      <div class="h-full">
        <!-- Company card — styled like author card -->
        <div class="bg-white border border-gray-100 rounded-2xl p-6 text-center shadow-sm h-full flex flex-col justify-center">
          <!-- Logo -->
          <img
            src={`${import.meta.env.BASE_URL}images/logo.png`}
            alt="PL Poly Trade s.r.o."
            class="h-20 w-auto mx-auto mb-3"
          />
          <div class="mb-4">
            <p class="font-bold text-[#1a2654] text-sm">PL PolyTrade s.r.o.</p>
            <p class="text-xs text-gray-500 leading-relaxed mt-1">Školská 660/3, 110 00 Praha 1</p>
            <p class="text-xs text-gray-400 mt-1">{t(lang, 'about_ico')}: 244 26 091</p>
          </div>
          <p class="text-gray-400 text-xs leading-relaxed mb-4">
            {lang === 'en'
              ? 'Czech company operating three specialist e-commerce brands.'
              : 'Česká společnost provozující tři specializované e-commerce značky.'}
          </p>
          <!-- Social-style brand links -->
          <div class="flex justify-center gap-3">
            <a href="https://www.profinuzky.cz/" target="_blank" rel="noopener noreferrer" title="ProfiNůžky" class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center text-gray-600 hover:bg-blue-100 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="6.5" cy="6.5" r="2.5" stroke-width="1.8"></circle>
                <circle cx="6.5" cy="17.5" r="2.5" stroke-width="1.8"></circle>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 8.2L19 18"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 15.8L14 10.3"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 10.3L19 6"></path>
              </svg>
            </a>
            <a href="https://gardenandhobby.com/" target="_blank" rel="noopener noreferrer" title="Garden & Hobby" class="w-8 h-8 bg-green-50 rounded-lg flex items-center justify-center text-gray-600 hover:bg-green-100 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 5c-7.2 0-12 4.8-12 12"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 19c-1.7-6.7 1.2-10.8 9-12-0.2 7.7-4.3 10.6-9 12z"></path>
              </svg>
            </a>
            <a href="https://grillandhobby.com/" target="_blank" rel="noopener noreferrer" title="Grill & Hobby" class="w-8 h-8 bg-orange-50 rounded-lg flex items-center justify-center text-gray-600 hover:bg-orange-100 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3c1 2.8 4.2 4.2 4.2 8a4.2 4.2 0 11-8.4 0c0-1.9.9-3.5 2.2-4.8"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 13c.8 1 1.5 1.9 1.5 3a1.5 1.5 0 11-3 0c0-.7.3-1.4.8-2"></path>
              </svg>
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
