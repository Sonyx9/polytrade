---
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="contact" class="py-14 bg-gray-50 border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 items-stretch">

      <!-- Left -->
      <div>
        <h2 class="text-2xl font-extrabold text-[#1a1a2e] mb-2 tracking-tight">
          {t(lang, 'contact_title')}
        </h2>
        <p class="text-gray-500 text-sm mb-8">
          {t(lang, 'contact_subtitle')}
        </p>

        <!-- Brand links styled like article rows -->
        <div class="space-y-3">
          {[
            { name: 'ProfiNůžky', href: 'https://www.profinuzky.cz/', icon: 'scissors', sub: 'profinuzky.cz' },
            { name: 'Garden & Hobby', href: 'https://gardenandhobby.com/', icon: 'leaf', sub: 'gardenandhobby.com' },
            { name: 'Grill & Hobby', href: 'https://grillandhobby.com/', icon: 'flame', sub: 'grillandhobby.com' },
          ].map(b => (
            <a
              href={b.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-3.5 rounded-xl border border-gray-200 bg-white hover:border-[#1a1a2e]/30 hover:shadow-sm transition-all group"
            >
              <span class="w-8 h-8 text-gray-500 flex items-center justify-center">
                {b.icon === 'scissors' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <circle cx="6.5" cy="6.5" r="2.5" stroke-width="1.8"></circle>
                    <circle cx="6.5" cy="17.5" r="2.5" stroke-width="1.8"></circle>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 8.2L19 18"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 15.8L14 10.3"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 10.3L19 6"></path>
                  </svg>
                )}
                {b.icon === 'leaf' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 5c-7.2 0-12 4.8-12 12"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 19c-1.7-6.7 1.2-10.8 9-12-0.2 7.7-4.3 10.6-9 12z"></path>
                  </svg>
                )}
                {b.icon === 'flame' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3c1 2.8 4.2 4.2 4.2 8a4.2 4.2 0 11-8.4 0c0-1.9.9-3.5 2.2-4.8"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 13c.8 1 1.5 1.9 1.5 3a1.5 1.5 0 11-3 0c0-.7.3-1.4.8-2"></path>
                  </svg>
                )}
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-[#1a1a2e]">{b.name}</p>
                <p class="text-xs text-gray-400">{b.sub}</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 group-hover:text-[#1a1a2e] transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Right: direct contact -->
      <div class="bg-white rounded-2xl p-7 border border-gray-200 shadow-sm h-full flex flex-col">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4">
          {lang === 'en' ? 'Direct Contact' : 'Přímý kontakt'}
        </p>

        <div class="grid sm:grid-cols-2 gap-4 flex-1 h-full content-stretch">
          <a
            href="tel:+420000000000"
            class="flex items-center justify-center p-6 rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50/70 hover:border-[#1a1a2e]/20 hover:shadow-sm transition-all group h-full"
            aria-label={lang === 'en' ? 'Call us' : 'Zavolejte nám'}
          >
            <span class="w-24 h-24 rounded-2xl bg-white border border-gray-200 text-[#1a1a2e] flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5.5C3 4.7 3.7 4 4.5 4H7a1 1 0 01.95.68l1.1 3.3a1 1 0 01-.27 1.04L7.4 10.4a14.2 14.2 0 006.2 6.2l1.38-1.38a1 1 0 011.04-.27l3.3 1.1A1 1 0 0120 17v2.5a1.5 1.5 0 01-1.5 1.5h-.6C9.67 21 3 14.33 3 6.1v-.6z"></path>
              </svg>
            </span>
          </a>

          <a
            href="mailto:info@plpolytrade.cz"
            class="flex items-center justify-center p-6 rounded-2xl border border-gray-200 bg-gradient-to-b from-white to-gray-50/70 hover:border-[#1a1a2e]/20 hover:shadow-sm transition-all group h-full"
            aria-label={lang === 'en' ? 'Send us an email' : 'Napište nám e-mail'}
          >
            <span class="w-24 h-24 rounded-2xl bg-white border border-gray-200 text-[#1a1a2e] flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke-width="1.8"></rect>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7l8 6 8-6"></path>
              </svg>
            </span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
