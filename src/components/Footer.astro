---
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-[#0f0f1a] border-t border-white/10 py-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-8">
      <!-- Logo + name -->
      <a href={lang === 'en' ? '/' : '/cs/'} class="flex items-center gap-2">
        <div class="w-7 h-7 bg-[#c4a572] rounded-md flex items-center justify-center">
          <span class="text-[#1a2654] text-[10px] font-extrabold">PT</span>
        </div>
        <span class="text-white font-bold text-sm">PolyTrade</span>
      </a>

      <!-- Brand links -->
      <div class="flex items-center gap-5 text-sm text-gray-300">
        <a href="https://www.profinuzky.cz/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
          <span class="text-[#c4a572]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <circle cx="6.5" cy="6.5" r="2.5" stroke-width="1.8"></circle>
              <circle cx="6.5" cy="17.5" r="2.5" stroke-width="1.8"></circle>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 8.2L19 18"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 15.8L14 10.3"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 10.3L19 6"></path>
            </svg>
          </span>
          ProfiNůžky
        </a>
        <a href="https://gardenandhobby.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
          <span class="text-[#c4a572]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 5c-7.2 0-12 4.8-12 12"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 19c-1.7-6.7 1.2-10.8 9-12-0.2 7.7-4.3 10.6-9 12z"></path>
            </svg>
          </span>
          Garden & Hobby
        </a>
        <a href="https://grillandhobby.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-1.5">
          <span class="text-[#c4a572]">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3c1 2.8 4.2 4.2 4.2 8a4.2 4.2 0 11-8.4 0c0-1.9.9-3.5 2.2-4.8"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 13c.8 1 1.5 1.9 1.5 3a1.5 1.5 0 11-3 0c0-.7.3-1.4.8-2"></path>
            </svg>
          </span>
          Grill & Hobby
        </a>
      </div>

      <!-- Lang switch -->
      <div class="flex items-center gap-2 text-xs text-gray-300">
        <a href="/" class={`hover:text-white transition-colors ${lang === 'en' ? 'text-[#c4a572]' : ''}`}>EN</a>
        <span>·</span>
        <a href="/cs/" class={`hover:text-white transition-colors ${lang === 'cs' ? 'text-[#c4a572]' : ''}`}>CS</a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-400">
      <p>&copy; {year} PL PolyTrade s.r.o. — {t(lang, 'footer_rights')}</p>
      <p>Školská 660/3, 110 00 Praha 1 &bull; {t(lang, 'about_ico')}: 244 26 091</p>
    </div>
  </div>
</footer>
