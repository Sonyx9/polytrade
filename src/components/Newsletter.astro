---
import type { Lang } from '../i18n';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const assetBase = import.meta.env.BASE_URL;
---

<section class="bg-[#1a1a2e] py-16 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-10 items-center">

      <!-- Left: general company CTA -->
      <div class="max-w-lg">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3 leading-snug">
          {lang === 'en' ? 'Built on quality. Focused on value.' : 'Stavíme na kvalitě. Soustředíme se na hodnotu.'}
        </h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-7">
          {lang === 'en'
            ? 'PL PolyTrade connects specialized brands for tailoring, gardening, and grilling. We focus on reliable products, clear service, and long-term trust.'
            : 'PL PolyTrade propojuje specializované značky pro krejčovství, zahradu a grilování. Zaměřujeme se na spolehlivé produkty, jasný servis a dlouhodobou důvěru.'}
        </p>

        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-white text-[#1a1a2e] font-bold px-5 py-2.5 rounded-lg hover:bg-gray-100 transition-colors text-sm"
        >
          {lang === 'en' ? 'Contact us' : 'Kontaktujte nás'}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>

      <!-- Right: lifestyle image -->
      <div class="relative flex justify-center lg:justify-end">
        <img
          src={`${assetBase}images/Fresh_vegetables_on_202603311644 (1).jpeg`}
          alt={lang === 'en' ? 'PL PolyTrade brand portfolio' : 'Portfolio značek PL PolyTrade'}
          class="w-full max-w-md lg:max-w-lg rounded-2xl object-cover aspect-[16/10] shadow-2xl border border-white/10"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>
